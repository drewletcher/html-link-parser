  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "saxParser",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/test/saxParser.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "saxStream",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/test/saxStream.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "getCells",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/test/getCells.js"
    },
    {
      "type": "node-terminal",
      "name": "---",
      "request": "launch"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "HtmlLinkParser",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/test/HtmlLinkParser.test.js"
    },
    {
      "type": "node",
      "name": "HtmlLinkReader",
      "program": "${workspaceFolder}/test/HtmlLinkReader.test.js",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node-terminal",
      "name": "--- hlp",
      "request": "launch"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "hlp helloworld",
      "program": "html-link-parser.js",
      "args": [ ".\\test\\data\\html\\helloworld.html" ],
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "hlp helloworld global",
      "program": "html-link-parser.js",
      "args": [ ".\\test\\data\\html\\helloworld.html", "--id=global" ],
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "hlp helloworld bigbang",
      "program": "html-link-parser.js",
      "args": [ ".\\test\\data\\html\\helloworld.html", "--heading=Greetings" ],
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
